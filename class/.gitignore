# TypeScript incremental build cache.
*.tsbuildinfo

# Regenerated by Next on every build, and its contents differ depending
# on whether `next dev` or `next build` ran last — so tracking it means
# a spurious diff every time you switch between the two. Next's own
# scaffolding ignores it for the same reason.
next-env.d.ts

# Real secrets. .env.example is the committed template.
.env
.env.local
.env*.local
