# Copy to .env.local for `npm run dev`, and set the same variables in the
# class app's Vercel project. None of these are NEXT_PUBLIC_: every one is
# read server-side only, and a leaked signing key or API key is the whole
# security boundary of phase 1.

# HMAC key for signing class links. Rotating it invalidates every link
# that has been handed out, which is the intended revocation mechanism.
# Generate with: openssl rand -base64 32
CLASS_LINK_SECRET=

# Shared secret for the admin page, re-checked on every submission.
# Generate with: openssl rand -base64 32
CLASS_ADMIN_SECRET=

# The unguessable path segment the admin page lives behind, i.e. the
# <key> in /class/admin/<key>. Use something URL-safe and long.
# Generate with: openssl rand -hex 16
CLASS_ADMIN_PATH=

# Daily REST API key, from the Daily dashboard.
DAILY_API_KEY=

# Daily subdomain — the "x" in https://x.daily.co/<room>.
DAILY_DOMAIN=

# The origin students actually visit: the articles site's domain, not
# this app's own Vercel URL. Class links are built from it, and /class is
# reached through the microfrontends routing in site/microfrontends.json.
# Scheme included, no
# trailing slash — for example https://example.com
CLASS_PUBLIC_ORIGIN=

# --- Supabase -------------------------------------------------------
#
# Accounts, roles, scheduling and the session record. The project is in
# an EU region because students may be in the EEA and the region is
# chosen once — see research/accounts-and-scheduling/05-register.md
# item 7. On the free plan it pauses after a week idle and has to be
# resumed by hand, so the plan moves to Pro before the first real
# student (item 1).

# The project URL, from Settings → API. Not a secret, but kept here with
# the rest so a deployment is configured from one list.
SUPABASE_URL=

# The service-role key. This bypasses every RLS policy, which is why it
# is server-side only and must never become NEXT_PUBLIC_. Authorisation
# is decided in server code (02 §3c); RLS is the second line, not the
# first, so a leak of this key is a total compromise of the data.
SUPABASE_SERVICE_ROLE_KEY=

# The anon/publishable key, used for the magic-link sign-in flow where
# the request genuinely acts as the visitor rather than as the app.
SUPABASE_ANON_KEY=
