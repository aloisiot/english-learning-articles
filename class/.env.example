# Copy to .env.local for `npm run dev`, and set the same variables in the
# class app's Vercel project. None of these are NEXT_PUBLIC_: every one is
# read server-side only, and a leaked signing key or API key is the whole
# security boundary of phase 1.

# HMAC key for signing class links. Rotating it invalidates every link
# that has been handed out, which is the intended revocation mechanism.
# Generate with: openssl rand -base64 32
CLASS_LINK_SECRET=

# Shared secret for the admin page, re-checked on every submission.
# Generate with: openssl rand -base64 32
CLASS_ADMIN_SECRET=

# The unguessable path segment the admin page lives behind, i.e. the
# <key> in /class/admin/<key>. Use something URL-safe and long.
# Generate with: openssl rand -hex 16
CLASS_ADMIN_PATH=

# Daily REST API key, from the Daily dashboard.
DAILY_API_KEY=

# Daily subdomain — the "x" in https://x.daily.co/<room>.
DAILY_DOMAIN=

# The origin students actually visit: the articles site's domain, not
# this app's own Vercel URL. Class links are built from it, and /class is
# reached through the rewrite in site/vercel.json. Scheme included, no
# trailing slash — for example https://example.com
CLASS_PUBLIC_ORIGIN=
