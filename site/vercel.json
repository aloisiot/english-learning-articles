{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/class/:path*",
      "destination": "https://<CLASS_APP_PRODUCTION_DOMAIN>/class/:path*"
    }
  ]
}
